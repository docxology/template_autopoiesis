# template_autopoiesis root gitignore.
# Local caches and build artifacts that should not be tracked. output/ IS
# tracked (like every other public exemplar) — it is this project's
# reproducibility bundle.
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
benchmarks/
.hypothesis/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
dist/
build/
